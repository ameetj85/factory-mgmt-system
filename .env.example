# SQLite Cloud connection string, e.g. sqlitecloud://<host>.sqlite.cloud:8860/factory.sqlite?apikey=<key>
SQLITE_CONNECTION_STRING=

# Public base URL of the app, used in password reset emails. Required in production.
APP_URL=http://localhost:3000

# SMTP server for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Factory Management System <no-reply@example.com>"
