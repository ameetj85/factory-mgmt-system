# Database provider (see lib/db/factory.mjs). Defaults to turso.
# DB_PROVIDER=turso

# Turso Cloud database URL and auth token, e.g. libsql://<database>-<organization>.<region>.turso.io
# A local file also works for throwaway test databases: TURSO_DATABASE_URL=file:./factory_test.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public base URL of the app, used in password reset emails. Required in production.
APP_URL=http://localhost:3000

# SMTP server for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Scheduled backups (optional): hours between backups while the server runs, folder, and how many to keep
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

EMAIL_FROM="Factory Management System <no-reply@example.com>"
